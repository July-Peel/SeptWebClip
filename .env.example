# 复制为 .env 后按需修改：cp .env.example .env
# 不写的项使用 docker-compose.yml 里的默认值。

# ---- 端口 ----
# 容器映射到宿主机的地址和端口，nginx 反代到 127.0.0.1:8080
BIND_ADDR=127.0.0.1
PORT=8080

# ---- 有效期 ----
# 未钉住的便签多久后自动删除，支持 3d、72h、90m 这样的写法
CLIP_TTL=3d
# 多久检查一次过期便签
CLEANUP_INTERVAL=10m
# 同一台设备在这段时间内重复查看同一张便签，只记一次
VIEW_DEDUP=30m

# ---- 限制 ----
MAX_IMAGE_MB=20
# 任意文件的上限。nginx 的 client_max_body_size 要比它大几 MB
MAX_FILE_MB=50
MAX_TEXT_KB=1024
# 口令最少字符数
MIN_CODE_LEN=4

# ---- 图片存储：local 或 webdav ----
IMAGE_STORAGE=local
# local 模式：图片在宿主机上的目录
IMAGES_HOST_DIR=./data/images
# webdav 模式：填写目录地址和账号，例如 Nextcloud：
# WEBDAV_URL=https://cloud.example.com/remote.php/dav/files/me/SeptWebClip/
# 坚果云：https://dav.jianguoyun.com/dav/SeptWebClip/
WEBDAV_URL=
WEBDAV_USER=
WEBDAV_PASSWORD=

# ---- 数据目录（数据库和密钥）----
DATA_HOST_DIR=./data

# ---- 其他 ----
# 是否信任 nginx 传来的真实 IP。直接把端口暴露到公网时要改成 false
TRUST_PROXY=true
# 口令换算墙 ID 用的密钥，留空则自动生成并保存在 data/secret.key。
# 一旦更换，所有旧墙都无法再进入。
SECRET=
# 手写字体的 CSS 地址，留空则使用系统楷体
FONT_CSS_URL=https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-webfont@1.7.0/lxgwwenkaigbscreen.css
